{
  "name": "warden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser retro-terminal game: fool an AI warden by editing its environment. Kiroween 2026.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --passWithNoTests",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "mcp": "tsx tools/mcp/server.ts",
    "playtest": "tsx tools/playtest/cli.ts",
    "validate:levels": "tsx tools/validate-level.ts",
    "e2e": "tsx tools/e2e.ts",
    "bench": "tsx tools/bench.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.89",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fast-check": "4.10.2",
    "playwright-core": "1.65.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
